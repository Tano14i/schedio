# ── Etsy ────────────────────────────────────────────────────────────────────
ETSY_API_KEY=           # Etsy developer app → API Key (Keystring)
ETSY_ACCESS_TOKEN=      # OAuth 2.0 access token  (see SETUP.md)
ETSY_REFRESH_TOKEN=     # OAuth 2.0 refresh token (see SETUP.md)
ETSY_SHOP_ID=           # Numeric shop ID — see SETUP.md Step 1.3
ETSY_WEBHOOK_SECRET=    # Shared secret set when registering the webhook

# ── Printify ─────────────────────────────────────────────────────────────────
PRINTIFY_API_KEY=       # Printify dashboard → My Profile → Connections → API
PRINTIFY_SHOP_ID=       # Visible in the Printify dashboard URL
PRINTIFY_WEBHOOK_SECRET=# Secret you choose when registering the Printify webhook

# ── Claude (used by future listing + CS agent layers) ────────────────────────
ANTHROPIC_API_KEY=      # https://console.anthropic.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
