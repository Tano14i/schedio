# Sampietrino — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Anthropic API key — required for Chef Remo AI
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Domini autorizzati a chiamare /api/chef, separati da virgole.
# Default: https://sampietrinonl.netlify.app — aggiungi qui il dominio definitivo.
ALLOWED_ORIGINS=https://sampietrinonl.netlify.app
